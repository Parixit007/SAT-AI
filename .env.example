# Copy to .env in this same directory (repo root) and fill in. See backend/app/config.py for defaults.

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b

# Google Earth Engine (noncommercial/free tier) -- register a Cloud project + service account at
# https://earthengine.google.com, then https://console.cloud.google.com > IAM & Admin > Service
# Accounts to create the account and download its JSON key.
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_FILE=

# Hugging Face read token, for the gated PaliGemma VQA model. Accept the license once at
# https://huggingface.co/google/paligemma-3b-ft-rsvqa-lr-224 with the same account, then create a
# read token at https://huggingface.co/settings/tokens.
HF_TOKEN=
VQA_MODEL_ID=google/paligemma-3b-ft-rsvqa-lr-224

# Phrase the final answer with the LLM from the tools' own outputs (answer_composer.py). false = plain join of each tool's summary.
COMPOSE_ANSWERS=true

# Use the trained remote-sensing captioner in "describe this image" (models/captioning/checkpoints/caption_model/,
# see CLAUDE.md). Off by default: it misreads natural land cover (farmland, wind farms) as urban scenes and
# miscounts, so the answer falls back to the honest object scan unless you opt in. Needs a backend restart.
ENABLE_CAPTIONER=false
